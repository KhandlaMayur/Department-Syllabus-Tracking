# ==========================================
# SERVER CONFIG
# ==========================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ==========================================
# FRONTEND
# ==========================================
CLIENT_URL=http://localhost:5173

# ==========================================
# DATABASE (MySQL)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=syllabus_tracker
DB_CONNECTION_LIMIT=10

# ==========================================
# AUTH0 CONFIG
# ==========================================
AUTH0_DOMAIN=dev-f3x1gt78huzgn1l3.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# ==========================================
# GOOGLE OAUTH 2.0 (Optional / Direct)
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# JWT
# ==========================================
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ==========================================
# ALLOWED EMAIL DOMAIN (restrict login to university domain)
# Leave blank to allow any domain (not recommended for production)
# ==========================================
ALLOWED_EMAIL_DOMAIN=marwadiuniversity.ac.in

# ==========================================
# DUAL-DOMAIN ROUTING (Phase 2)
# Students must use @marwadiuniversity.ac.in
# Faculty/HOD/CC must use @marwadieducation.edu.in
# ==========================================
STUDENT_EMAIL_DOMAIN=marwadiuniversity.ac.in
FACULTY_EMAIL_DOMAIN=marwadieducation.edu.in
